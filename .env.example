# Copie para ".env". Variáveis VITE_* ficam VISÍVEIS no navegador:
# nunca coloque chaves do Supabase aqui (o frontend só fala com a API).

# URL base da API (backend). SEMPRE termina em /api
# Local:     http://localhost:3333/api
# Produção:  https://SEU-BACKEND.vercel.app/api   (configure no painel da Vercel)
VITE_API_BASE_URL=http://localhost:3333/api

# true = joga sem backend (progresso só no navegador) | false = usa a API
VITE_USE_MOCK=false

# Tempo máximo (ms) de espera das chamadas à API
VITE_API_TIMEOUT=12000

# Tempo máximo (ms) para a geração do PDF no servidor. Depois disso, usa o relatório local.
VITE_PDF_TIMEOUT=45000
